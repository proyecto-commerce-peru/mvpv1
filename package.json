{
    "name": "seller-bot-v1",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "prisma": "prisma",
        "prisma:validate": "prisma validate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:reset": "prisma migrate reset --force",
        "prisma:sqlite:migrate": "DATABASE_URL=file:./primas.db prisma migrate dev --schema prisma/schema.sqlite.prisma --name init-primas",
        "prisma:seed": "prisma db execute --schema prisma/schema.prisma --file databases/seed_primas.sql",
        "test": "jest --runInBand",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "better-auth": "^1.3.7",
        "next": "16.1.6",
        "react": "19.2.3",
        "react-dom": "19.2.3"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.3.0",
        "@tailwindcss/postcss": "^4",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.19.33",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/supertest": "^6.0.3",
        "eslint": "^9",
        "eslint-config-next": "16.1.6",
        "jest": "^29.7.0",
        "prisma": "^5.22.0",
        "supertest": "^7.1.0",
        "tailwindcss": "^4",
        "ts-node": "^10.9.2",
        "typescript": "^5"
    },
    "packageManager": "npm@10",
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    }
}

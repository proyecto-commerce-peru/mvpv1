generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                     String                   @id @db.Uuid
  name                   String                   @db.VarChar(160)
  legal_name             String?                  @db.VarChar(200)
  tax_id                 String?                  @db.VarChar(32)
  slug                   String                   @unique @db.VarChar(160)
  status                 String                   @default("ACTIVE") @db.VarChar(24)
  country_code           String                   @default("PE") @db.Char(2)
  timezone               String                   @default("America/Lima") @db.VarChar(64)
  currency_code          String                   @default("PEN") @db.Char(3)
  metadata               Json?
  created_at             DateTime                 @db.Timestamptz(6)
  updated_at             DateTime                 @db.Timestamptz(6)
  deleted_at             DateTime?                @db.Timestamptz(6)
  TenantSetting          TenantSetting[]
  TenantStore            TenantStore[]
  TenantDomain           TenantDomain[]
  TenantSaasSubscription TenantSaasSubscription?
  SaasInvoice            SaasInvoice[]
  User                   User[]
  UserProfile            UserProfile[]
  AuthIdentity           AuthIdentity[]
  PasswordResetToken     PasswordResetToken[]
  Role                   Role[]
  RolePermission         RolePermission[]
  UserRole               UserRole[]
  Customer               Customer[]
  Tag                    Tag[]
  CustomerTag            CustomerTag[]
  CustomerAddress        CustomerAddress[]
  Catalog                Catalog[]
  Category               Category[]
  StoreOffering          StoreOffering[]
  StoreOfferingCategory  StoreOfferingCategory[]
  StoreOfferingImage     StoreOfferingImage[]
  StoreOfferingAttribute StoreOfferingAttribute[]
  OptionType             OptionType[]
  OptionValue            OptionValue[]
  StoreVariant           StoreVariant[]
  StoreVariantOption     StoreVariantOption[]
  ProductDetail          ProductDetail[]
  ServiceDetail          ServiceDetail[]
  MembershipPlan         MembershipPlan[]
  PriceList              PriceList[]
  Price                  Price[]
  InventoryLocation      InventoryLocation[]
  StockItem              StockItem[]
  StockBalance           StockBalance[]
  StockMovement          StockMovement[]
  Cart                   Cart[]
  CartItem               CartItem[]
  Order                  Order[]
  OrderItem              OrderItem[]
  Fulfillment            Fulfillment[]
  ServiceBooking         ServiceBooking[]
  CustomerMembership     CustomerMembership[]
  Coupon                 Coupon[]
  CouponRule             CouponRule[]
  PaymentMethod          PaymentMethod[]
  Payment                Payment[]
  Refund                 Refund[]
  TaxDocument            TaxDocument[]
  WhatsappAccount        WhatsappAccount[]
  WhatsappConversation   WhatsappConversation[]
  WhatsappMessage        WhatsappMessage[]
  WhatsappTemplate       WhatsappTemplate[]
  ConversationOrder      ConversationOrder[]
  WebhookEvent           WebhookEvent[]
  OutboxEvent            OutboxEvent[]
  AuditLog               AuditLog[]
  Prospect               Prospect[]
  Report                 Report[]

  @@index([status])
  @@index([country_code])
  @@index([created_at])
  @@map("tenants")
}

model TenantSetting {
  id         String   @id @db.Uuid
  tenant_id  String   @db.Uuid
  key        String   @db.VarChar(120)
  value      Json
  scope      String   @default("TENANT") @db.VarChar(24)
  created_at DateTime @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, key])
  @@index([tenant_id, scope, key])
  @@map("tenant_settings")
}

model TenantStore {
  id           String    @id @db.Uuid
  tenant_id    String    @db.Uuid
  name         String    @db.VarChar(160)
  channel      String    @default("WEB") @db.VarChar(24)
  status       String    @default("ACTIVE") @db.VarChar(24)
  address_text String?   @db.VarChar(300)
  metadata     Json?
  created_at   DateTime  @db.Timestamptz(6)
  updated_at   DateTime  @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)

  tenant            Tenant              @relation(fields: [tenant_id], references: [id])
  Catalog           Catalog?
  InventoryLocation InventoryLocation[]
  WhatsappAccount   WhatsappAccount[]
  Prospect          Prospect[]
  Report            Report[]

  @@index([tenant_id, name])
  @@index([tenant_id, status])
  @@map("tenant_stores")
}

model TenantDomain {
  id          String    @id @db.Uuid
  tenant_id   String    @db.Uuid
  domain      String    @db.VarChar(255)
  is_primary  Boolean   @default(false)
  is_verified Boolean   @default(false)
  verified_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([domain])
  @@unique([tenant_id, domain])
  @@index([tenant_id, is_primary])
  @@map("tenant_domains")
}

model SaasSubscription {
  id                     String                   @id @db.Uuid
  code                   String                   @unique @db.VarChar(40)
  name                   String                   @db.VarChar(120)
  description            String?                  @db.Text
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @db.Timestamptz(6)
  updated_at             DateTime                 @db.Timestamptz(6)
  MembershipCondition    MembershipCondition[]
  TenantSaasSubscription TenantSaasSubscription[]

  @@map("saas_subscriptions")
}

model MembershipCondition {
  id                   String   @id @db.Uuid
  saas_subscription_id String   @db.Uuid
  key                  String   @db.VarChar(120)
  value                Json
  created_at           DateTime @db.Timestamptz(6)
  updated_at           DateTime @db.Timestamptz(6)

  saas_subscription SaasSubscription @relation(fields: [saas_subscription_id], references: [id])

  @@unique([saas_subscription_id, key])
  @@map("membership_conditions")
}

model TenantSaasSubscription {
  id                   String    @id @db.Uuid
  tenant_id            String    @db.Uuid
  saas_subscription_id String    @db.Uuid
  status               String    @default("ACTIVE") @db.VarChar(24)
  started_at           DateTime  @db.Timestamptz(6)
  ends_at              DateTime? @db.Timestamptz(6)
  trial_ends_at        DateTime? @db.Timestamptz(6)
  cancel_at_period_end Boolean   @default(false)
  metadata             Json?
  created_at           DateTime  @db.Timestamptz(6)
  updated_at           DateTime  @db.Timestamptz(6)

  tenant            Tenant           @relation(fields: [tenant_id], references: [id])
  saas_subscription SaasSubscription @relation(fields: [saas_subscription_id], references: [id])
  SaasInvoice       SaasInvoice[]

  @@unique([tenant_id])
  @@index([saas_subscription_id])
  @@index([status])
  @@map("tenant_saas_subscriptions")
}

model SaasInvoice {
  id                          String    @id @db.Uuid
  tenant_id                   String    @db.Uuid
  tenant_saas_subscription_id String?   @db.Uuid
  invoice_number              String    @db.VarChar(64)
  currency_code               String    @default("PEN") @db.Char(3)
  amount_total                Decimal   @db.Decimal
  amount_paid                 Decimal   @default(0) @db.Decimal
  status                      String    @default("OPEN") @db.VarChar(24)
  due_date                    DateTime? @db.Timestamptz(6)
  paid_at                     DateTime? @db.Timestamptz(6)
  provider                    String?   @db.VarChar(40)
  provider_invoice_id         String?   @db.VarChar(140)
  metadata                    Json?
  created_at                  DateTime  @db.Timestamptz(6)
  updated_at                  DateTime  @db.Timestamptz(6)

  tenant                   Tenant                  @relation(fields: [tenant_id], references: [id])
  tenant_saas_subscription TenantSaasSubscription? @relation(fields: [tenant_saas_subscription_id], references: [id])

  @@unique([tenant_id, invoice_number])
  @@index([tenant_id, status])
  @@index([provider, provider_invoice_id])
  @@map("saas_invoices")
}

model User {
  id                 String    @id @db.Uuid
  tenant_id          String    @db.Uuid
  email              String    @db.VarChar(255)
  status             String    @default("ACTIVE") @db.VarChar(24)
  email_verified_at  DateTime? @db.Timestamptz(6)
  invited_by_user_id String?   @db.Uuid
  invited_at         DateTime? @db.Timestamptz(6)
  last_login_at      DateTime? @db.Timestamptz(6)
  metadata           Json?
  created_at         DateTime  @db.Timestamptz(6)
  updated_at         DateTime  @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)

  tenant             Tenant               @relation(fields: [tenant_id], references: [id])
  invitedBy          User?                @relation("UserInvitations", fields: [invited_by_user_id], references: [id])
  invitedUsers       User[]               @relation("UserInvitations")
  UserProfile        UserProfile[]
  AuthIdentity       AuthIdentity[]
  PasswordResetToken PasswordResetToken[]
  UserRole           UserRole[]
  StockMovement      StockMovement[]
  Order              Order[]
  ServiceBooking     ServiceBooking[]
  Refund             Refund[]
  AuditLog           AuditLog[]

  @@unique([tenant_id, email])
  @@index([tenant_id, status])
  @@map("users")
}

model UserProfile {
  id         String   @id @db.Uuid
  tenant_id  String   @db.Uuid
  user_id    String   @db.Uuid
  full_name  String   @db.VarChar(180)
  phone      String?  @db.VarChar(32)
  avatar_url String?  @db.Text
  locale     String   @default("es-PE") @db.VarChar(16)
  timezone   String   @default("America/Lima") @db.VarChar(64)
  metadata   Json?
  created_at DateTime @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])

  @@unique([tenant_id, user_id])
  @@map("user_profiles")
}

model AuthIdentity {
  id                  String    @id @db.Uuid
  tenant_id           String    @db.Uuid
  user_id             String    @db.Uuid
  provider            String    @db.VarChar(24)
  provider_user_id    String?   @db.VarChar(140)
  password_hash       String?   @db.VarChar(255)
  password_updated_at DateTime? @db.Timestamptz(6)
  mfa_enabled         Boolean   @default(false)
  created_at          DateTime  @db.Timestamptz(6)
  updated_at          DateTime  @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])

  @@unique([tenant_id, user_id, provider])
  @@index([tenant_id, provider, provider_user_id])
  @@map("auth_identities")
}

model PasswordResetToken {
  id         String    @id @db.Uuid
  tenant_id  String    @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])

  @@unique([token_hash])
  @@index([tenant_id, user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

model Role {
  id          String   @id @db.Uuid
  tenant_id   String   @db.Uuid
  name        String   @db.VarChar(80)
  description String?  @db.Text
  is_system   Boolean  @default(false)
  created_at  DateTime @db.Timestamptz(6)
  updated_at  DateTime @db.Timestamptz(6)

  tenant         Tenant           @relation(fields: [tenant_id], references: [id])
  RolePermission RolePermission[]
  UserRole       UserRole[]

  @@unique([tenant_id, name])
  @@map("roles")
}

model Permission {
  id             String           @id @db.Uuid
  key            String           @unique @db.VarChar(140)
  description    String?          @db.Text
  RolePermission RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String @id @db.Uuid
  tenant_id     String @db.Uuid
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  tenant     Tenant     @relation(fields: [tenant_id], references: [id])
  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@unique([tenant_id, role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @db.Uuid
  tenant_id  String   @db.Uuid
  user_id    String   @db.Uuid
  role_id    String   @db.Uuid
  created_at DateTime @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])
  role   Role   @relation(fields: [role_id], references: [id])

  @@unique([tenant_id, user_id, role_id])
  @@map("user_roles")
}

model Customer {
  id               String    @id @db.Uuid
  tenant_id        String    @db.Uuid
  full_name        String?   @db.VarChar(180)
  phone_e164       String    @db.VarChar(32)
  email            String?   @db.VarChar(255)
  status           String    @default("ACTIVE") @db.VarChar(24)
  marketing_opt_in Boolean   @default(false)
  metadata         Json?
  created_at       DateTime  @db.Timestamptz(6)
  updated_at       DateTime  @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)

  tenant               Tenant                 @relation(fields: [tenant_id], references: [id])
  CustomerTag          CustomerTag[]
  CustomerAddress      CustomerAddress[]
  Cart                 Cart[]
  Order                Order[]
  ServiceBooking       ServiceBooking[]
  CustomerMembership   CustomerMembership[]
  WhatsappConversation WhatsappConversation[]

  @@unique([tenant_id, phone_e164])
  @@index([tenant_id, email])
  @@index([tenant_id, status])
  @@map("customers")
}

model Tag {
  id        String @id @db.Uuid
  tenant_id String @db.Uuid
  name      String @db.VarChar(80)

  tenant      Tenant        @relation(fields: [tenant_id], references: [id])
  CustomerTag CustomerTag[]

  @@unique([tenant_id, name])
  @@map("tags")
}

model CustomerTag {
  id          String   @id @db.Uuid
  tenant_id   String   @db.Uuid
  customer_id String   @db.Uuid
  tag_id      String   @db.Uuid
  created_at  DateTime @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenant_id], references: [id])
  customer Customer @relation(fields: [customer_id], references: [id])
  tag      Tag      @relation(fields: [tag_id], references: [id])

  @@unique([tenant_id, customer_id, tag_id])
  @@map("customer_tags")
}

model CustomerAddress {
  id            String   @id @db.Uuid
  tenant_id     String   @db.Uuid
  customer_id   String   @db.Uuid
  label         String?  @db.VarChar(60)
  country_code  String   @default("PE") @db.Char(2)
  region        String?  @db.VarChar(80)
  city          String?  @db.VarChar(80)
  district      String?  @db.VarChar(80)
  address_line1 String   @db.VarChar(160)
  address_line2 String?  @db.VarChar(160)
  reference     String?  @db.VarChar(200)
  postal_code   String?  @db.VarChar(20)
  geo_lat       Decimal? @db.Decimal
  geo_lng       Decimal? @db.Decimal
  is_default    Boolean  @default(false)
  created_at    DateTime @db.Timestamptz(6)
  updated_at    DateTime @db.Timestamptz(6)

  tenant         Tenant   @relation(fields: [tenant_id], references: [id])
  customer       Customer @relation(fields: [customer_id], references: [id])
  shippingOrders Order[]  @relation("OrderShippingAddress")
  billingOrders  Order[]  @relation("OrderBillingAddress")

  @@index([tenant_id, customer_id])
  @@map("customer_addresses")
}

model Catalog {
  id         String   @id @db.Uuid
  tenant_id  String   @db.Uuid
  store_id   String   @db.Uuid
  name       String   @default("Default Catalog") @db.VarChar(120)
  status     String   @default("ACTIVE") @db.VarChar(24)
  created_at DateTime @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenant_id], references: [id])
  store         TenantStore     @relation(fields: [store_id], references: [id])
  Category      Category[]
  StoreOffering StoreOffering[]
  PriceList     PriceList[]

  @@unique([store_id])
  @@index([tenant_id, store_id])
  @@map("catalogs")
}

model Category {
  id         String   @id @db.Uuid
  tenant_id  String   @db.Uuid
  catalog_id String   @db.Uuid
  parent_id  String?  @db.Uuid
  name       String   @db.VarChar(140)
  slug       String   @db.VarChar(160)
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)

  tenant                Tenant                  @relation(fields: [tenant_id], references: [id])
  catalog               Catalog                 @relation(fields: [catalog_id], references: [id])
  parent                Category?               @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children              Category[]              @relation("CategoryHierarchy")
  StoreOfferingCategory StoreOfferingCategory[]
  CouponRule            CouponRule[]

  @@unique([catalog_id, slug])
  @@index([catalog_id, parent_id])
  @@map("categories")
}

model StoreOffering {
  id              String    @id @db.Uuid
  tenant_id       String    @db.Uuid
  catalog_id      String    @db.Uuid
  type            String    @db.VarChar(24)
  title           String    @db.VarChar(180)
  description     String?   @db.Text
  status          String    @default("ACTIVE") @db.VarChar(24)
  handle          String?   @db.VarChar(180)
  cover_image_url String?   @db.Text
  currency_code   String    @default("PEN") @db.Char(3)
  tax_code        String?   @db.VarChar(40)
  is_tax_included Boolean   @default(true)
  base_data       Json?
  created_at      DateTime  @db.Timestamptz(6)
  updated_at      DateTime  @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)

  tenant                 Tenant                   @relation(fields: [tenant_id], references: [id])
  catalog                Catalog                  @relation(fields: [catalog_id], references: [id])
  StoreOfferingCategory  StoreOfferingCategory[]
  StoreOfferingImage     StoreOfferingImage[]
  StoreOfferingAttribute StoreOfferingAttribute[]
  OptionType             OptionType[]
  StoreVariant           StoreVariant[]
  ProductDetail          ProductDetail[]
  ServiceDetail          ServiceDetail[]
  MembershipPlan         MembershipPlan[]
  Price                  Price[]
  StockItem              StockItem[]
  CartItem               CartItem[]
  OrderItem              OrderItem[]
  ServiceBooking         ServiceBooking[]
  CouponRule             CouponRule[]

  @@index([tenant_id, type])
  @@index([tenant_id, handle])
  @@index([catalog_id, status])
  @@map("store_offerings")
}

model StoreOfferingCategory {
  id          String   @id @db.Uuid
  tenant_id   String   @db.Uuid
  offering_id String   @db.Uuid
  category_id String   @db.Uuid
  created_at  DateTime @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenant_id], references: [id])
  offering StoreOffering @relation(fields: [offering_id], references: [id])
  category Category      @relation(fields: [category_id], references: [id])

  @@unique([tenant_id, offering_id, category_id])
  @@map("store_offering_categories")
}

model StoreOfferingImage {
  id          String   @id @db.Uuid
  tenant_id   String   @db.Uuid
  offering_id String   @db.Uuid
  url         String   @db.Text
  alt_text    String?  @db.VarChar(160)
  sort_order  Int      @default(0)
  created_at  DateTime @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenant_id], references: [id])
  offering StoreOffering @relation(fields: [offering_id], references: [id])

  @@index([tenant_id, offering_id, sort_order])
  @@map("store_offering_images")
}

model StoreOfferingAttribute {
  id          String   @id @db.Uuid
  tenant_id   String   @db.Uuid
  offering_id String   @db.Uuid
  key         String   @db.VarChar(120)
  value       String   @db.Text
  created_at  DateTime @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenant_id], references: [id])
  offering StoreOffering @relation(fields: [offering_id], references: [id])

  @@index([tenant_id, offering_id, key])
  @@map("store_offering_attributes")
}

model OptionType {
  id          String @id @db.Uuid
  tenant_id   String @db.Uuid
  offering_id String @db.Uuid
  name        String @db.VarChar(80)
  sort_order  Int    @default(0)

  tenant      Tenant        @relation(fields: [tenant_id], references: [id])
  offering    StoreOffering @relation(fields: [offering_id], references: [id])
  OptionValue OptionValue[]

  @@unique([tenant_id, offering_id, name])
  @@map("option_types")
}

model OptionValue {
  id             String @id @db.Uuid
  tenant_id      String @db.Uuid
  option_type_id String @db.Uuid
  value          String @db.VarChar(80)
  sort_order     Int    @default(0)

  tenant             Tenant               @relation(fields: [tenant_id], references: [id])
  optionType         OptionType           @relation(fields: [option_type_id], references: [id])
  StoreVariantOption StoreVariantOption[]

  @@unique([tenant_id, option_type_id, value])
  @@map("option_values")
}

model StoreVariant {
  id          String    @id @db.Uuid
  tenant_id   String    @db.Uuid
  offering_id String    @db.Uuid
  sku         String?   @db.VarChar(80)
  barcode     String?   @db.VarChar(80)
  status      String    @default("ACTIVE") @db.VarChar(24)
  price_final Decimal   @default(0) @db.Decimal
  tax_rate    Decimal   @default(0) @db.Decimal
  created_at  DateTime  @db.Timestamptz(6)
  updated_at  DateTime  @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  tenant             Tenant               @relation(fields: [tenant_id], references: [id])
  offering           StoreOffering        @relation(fields: [offering_id], references: [id])
  StoreVariantOption StoreVariantOption[]
  Price              Price[]
  StockItem          StockItem[]
  CartItem           CartItem[]
  OrderItem          OrderItem[]

  @@index([tenant_id, offering_id])
  @@index([tenant_id, sku])
  @@map("store_variants")
}

model StoreVariantOption {
  id              String @id @db.Uuid
  tenant_id       String @db.Uuid
  variant_id      String @db.Uuid
  option_value_id String @db.Uuid

  tenant      Tenant       @relation(fields: [tenant_id], references: [id])
  variant     StoreVariant @relation(fields: [variant_id], references: [id])
  optionValue OptionValue  @relation(fields: [option_value_id], references: [id])

  @@unique([tenant_id, variant_id, option_value_id])
  @@map("store_variant_options")
}

model ProductDetail {
  id                String   @id @db.Uuid
  tenant_id         String   @db.Uuid
  offering_id       String   @db.Uuid
  unit              String?  @db.VarChar(40)
  weight_kg         Decimal? @db.Decimal
  requires_shipping Boolean  @default(true)
  allow_backorder   Boolean  @default(false)
  shipping_data     Json?
  created_at        DateTime @db.Timestamptz(6)
  updated_at        DateTime @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenant_id], references: [id])
  offering StoreOffering @relation(fields: [offering_id], references: [id])

  @@unique([tenant_id, offering_id])
  @@map("product_details")
}

model ServiceDetail {
  id                String   @id @db.Uuid
  tenant_id         String   @db.Uuid
  offering_id       String   @db.Uuid
  duration_minutes  Int      @default(60)
  location_type     String   @db.VarChar(32)

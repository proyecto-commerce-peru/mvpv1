  status       String    @default("PENDING") @db.VarChar(16)
  available_at DateTime  @db.Timestamptz(6)
  sent_at      DateTime? @db.Timestamptz(6)
  attempts     Int       @default(0)
  last_error   String?   @db.Text
  created_at   DateTime  @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, status, available_at])
  @@index([tenant_id, topic, created_at])
  @@map("outbox_events")
}

model AuditLog {
  id            String   @id @db.Uuid
  tenant_id     String   @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String   @db.VarChar(180)
  entity_type   String   @db.VarChar(80)
  entity_id     String?  @db.Uuid
  before        Json?
  after         Json?
  ip            String?  @db.VarChar(48)
  user_agent    String?  @db.VarChar(200)
  created_at    DateTime @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenant_id], references: [id])
  actorUser User?  @relation(fields: [actor_user_id], references: [id])

  @@index([tenant_id, created_at])
  @@index([tenant_id, entity_type, entity_id])
  @@index([tenant_id, actor_user_id, created_at])
  @@map("audit_logs")
}

model Prospect {
  id         String   @id @db.Uuid
  tenant_id  String   @db.Uuid
  store_id   String?  @db.Uuid
  full_name  String?  @db.VarChar(180)
  phone_e164 String?  @db.VarChar(32)
  email      String?  @db.VarChar(255)
  source     String   @default("WHATSAPP") @db.VarChar(24)
  stage      String   @default("NEW") @db.VarChar(24)
  notes      String?  @db.Text
  metadata   Json?
  created_at DateTime @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)

  tenant Tenant       @relation(fields: [tenant_id], references: [id])
  store  TenantStore? @relation(fields: [store_id], references: [id])

  @@index([tenant_id, stage, created_at])
  @@index([tenant_id, phone_e164])
  @@map("prospects")
}

model Report {
  id           String   @id @db.Uuid
  tenant_id    String   @db.Uuid
  store_id     String?  @db.Uuid
  period       String   @db.VarChar(16)
  period_start DateTime @db.Date
  period_end   DateTime @db.Date
  metrics      Json
  created_at   DateTime @db.Timestamptz(6)

  tenant Tenant       @relation(fields: [tenant_id], references: [id])
  store  TenantStore? @relation(fields: [store_id], references: [id])

  @@unique([tenant_id, period, period_start, period_end])
  @@index([tenant_id, created_at])
  @@map("reports")
}
